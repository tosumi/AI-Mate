# =====================================================================
# MyCompanion 環境変数のひな形(本体仕様書 §11.5.9)
#
# - このファイルは変数名だけを持ち、値は空のままコミットする。
# - 実際の値は、コピーした .env(Git の対象外)に書くか、
#   クラウドでは Container Apps の環境変数として IaC から渡す。
# - パスワード・API キー・接続文字列などの秘密情報は、ここにも .env にも書かない。
#   Azure 上では Key Vault + マネージド ID、ローカルでは `az login` の資格情報を使う。
#   (例外: ローカルのエミュレータが公開している既定のキーだけは .env に書いてよい)
# =====================================================================

# ---------------------------------------------------------------------
# 1. デプロイ用(IaC・Azure CLI が使う。アプリ本体は読まない)
# ---------------------------------------------------------------------
AZURE_ENV_NAME=                 # dev / stg / prod
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=                # 運用側(ワークフォース)テナント
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=japaneast        # 所在地の方針(§11.5.6)。Japan East を主、必要なら japanwest
AZURE_DEV_PRINCIPAL_ID=         # 開発者の Entra のオブジェクトID(dev のデータアクセス権と PostgreSQL の管理者)
AZURE_DEV_PRINCIPAL_NAME=       # 開発者の Entra のサインイン名(UPN)
AZURE_DEV_CLIENT_IP=            # 開発者の PC のグローバル IP(dev のファイアウォールの許可。dev だけで使う)
AZURE_GITHUB_REPOSITORY=        # owner/name。GitHub Actions からのデプロイ用の ID を作る(空なら作らない。§15.1 の M6-5)
AZURE_GITHUB_OIDC_SUBJECT=      # GitHub が ID つきの subject(repo:owner@数字/name@数字:ref:refs/heads/main)を提示する場合に書く
AZURE_DEPLOY_REGISTRY=          # true: コンテナレジストリを作る(イメージを作る前の1回目)
AZURE_DEPLOY_CONTAINER_APPS=    # true: API と定期ジョブを作る
AZURE_APP_IMAGE=                # <レジストリ>.azurecr.io/mycompanion:<タグ>
AZURE_ALERT_EMAIL=              # 失敗の通知の宛先(メール)。空なら通知は送らず、警告の規則だけ作る
AZURE_DEPLOY_WEB=               # true: Web の画面(Static Web Apps)を作る(§15.1 の M7)
ENTRA_DIRECTORY_CLIENT_ID=      # 外部テナントのアカウントの削除に使うアプリ(§15.1 の M6-3。未設定なら、削除は保留のまま)

# ---------------------------------------------------------------------
# 2. アプリの実行時(API・ワーカー・スケジューラ)
# ---------------------------------------------------------------------
MYCOMPANION_ENV=                # dev / stg / prod。ログとメトリクスに付ける
AZURE_CLIENT_ID=                # ユーザー割り当てマネージド ID のクライアント ID(ローカルでは空)
MYCOMPANION_JOB_QUEUE=          # inline(既定。ローカル)/ servicebus(Container Apps)。§15.1 の M6-1
MYCOMPANION_WORKER_CONCURRENCY= # キューを並行して処理するセッションの数(既定 4)
MYCOMPANION_WEB_ORIGINS=        # Web の画面の配信元(CORS で許す。https、カンマ区切り。dev は http://localhost:<port> も可)。空なら許さない

# Azure OpenAI(§11.1)。認証はマネージド ID(Entra ID)。API キーは使わない
AZURE_OPENAI_ENDPOINT=          # https://<リソース名>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_EMOTION=        # デプロイ名(モデル名ではない)。infra の既定では gpt-5-4-mini
AZURE_OPENAI_DEPLOYMENT_PLANNER=        # 同上(gpt-5-4-mini)
AZURE_OPENAI_DEPLOYMENT_MEMORY_WRITE=   # 同上(gpt-5-4-mini)
AZURE_OPENAI_DEPLOYMENT_DRAFT=          # 応答の生成。gpt-6-2-sol(2026-11-20 に選定)
AZURE_OPENAI_DEPLOYMENT_FILTER=         # 感情フィルタ(危機フローと検証用の2段階)。gpt-6-2-sol
AZURE_OPENAI_DEPLOYMENT_CONSOLIDATION=  # infra の既定では gpt-6-1-sol
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=      # text-embedding-3-large(Standard / リージョナル)
# デプロイ名 → モデル名と版(評価・ターンの記録に使う)。未設定なら、記録はデプロイ名だけ。infra/main.bicep の openAiDeployments と合わせる
AZURE_OPENAI_MODELS=                    # 例: gpt-6-2-sol=gpt-6.2-sol:2026-11-17,gpt-5-4-mini=gpt-5.4-mini:2026-03-17

# PostgreSQL + pgvector(§11.5.3)。認証は Entra ID トークン。パスワードは使わない
POSTGRES_HOST=                  # <サーバー名>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=                  # マネージド ID(またはローカルの開発者)に対応する Entra のロール名
POSTGRES_SSLMODE=require

# Cosmos DB for NoSQL(§11.5.3)。認証は Entra ID(データプレーン RBAC)
COSMOS_ENDPOINT=                # https://<アカウント名>.documents.azure.com:443/
COSMOS_DATABASE=

# Service Bus(§11.5.4)。認証は Entra ID
SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=   # <名前空間>.servicebus.windows.net

# Key Vault(§11.5.6)。LINE のチャネルシークレット・アクセストークンなどはここから読む
KEY_VAULT_URI=                  # https://<名前>.vault.azure.net/

# 監視(§11.5.7)。クラウドでは Key Vault 参照で注入する
APPLICATIONINSIGHTS_CONNECTION_STRING=

# 認証(一般ユーザー。Entra External ID の外部テナント。§13.4)
ENTRA_EXTERNAL_TENANT_ID=
ENTRA_EXTERNAL_AUTHORITY=       # https://<サブドメイン>.ciamlogin.com/
ENTRA_API_AUDIENCE=             # API のアプリ登録(アプリケーション ID URI またはクライアント ID)
ENTRA_API_SCOPE=                # API が公開するスコープ(例: api://<API のクライアント ID>/companion.access)

# 運営者の認証(社内向けの Entra ID。今の Azure のテナント。§13.7、§15.1 の M9)。
# 設定しなければ、運営者の API(/ops/v1)は使えない(503)。一部だけの設定はエラー
OPS_ENTRA_TENANT_ID=            # 運営者のテナントの ID
OPS_ENTRA_API_AUDIENCE=         # 運営者の API のアプリ登録(アプリ ID の URI、例: api://<クライアント ID>)
OPS_ENTRA_API_SCOPE=            # 運営者の画面が要求するスコープ(例: api://<クライアント ID>/ops.access)
OPS_REQUIRE_MFA_CLAIM=          # true でトークンの amr に mfa を求める(テナントで MFA を必須にしたうえでの確認)
OPS_ENTRA_SPA_CLIENT_ID=        # 運営者の画面のアプリ登録(SPA)のクライアント ID(画面のビルドに使う)
# 運営者のダッシュボード(管理者だけ。Azure のリソース ID。dev では IaC が Container Apps に設定する。未設定の項目は「未設定」と表示)
OPS_MONITOR_API_APP_ID=
OPS_MONITOR_WORKER_JOB_ID=
OPS_MONITOR_POSTGRES_ID=
OPS_MONITOR_COSMOS_ID=
OPS_MONITOR_LOG_WORKSPACE_ID=
OPS_MONITOR_OPENAI_ID=

# ---------------------------------------------------------------------
# 3. クライアント(CLI。§11.5.8)
# ---------------------------------------------------------------------
MYCOMPANION_API_URL=            # http://localhost:8080 またはクラウドの API の URL。--api-url で上書き可
MYCOMPANION_CLI_CLIENT_ID=      # CLI のアプリ登録(パブリッククライアント、デバイスコード方式)

# Web の画面の接続先(本体仕様書 §15.1 の M7)。コピーして web/.env.local を作り、値を入れる(.env.local は Git の対象外)。
# どれも秘密情報ではないが、アカウントの情報なので、リポジトリには書かない。CI では、リポジトリの変数から入れる。
VITE_API_URL=               # API の URL(例: https://<api>.azurecontainerapps.io)。ローカルの API なら http://localhost:8080
VITE_ENTRA_AUTHORITY=       # https://<サブドメイン>.ciamlogin.com/
VITE_ENTRA_TENANT_ID=       # 外部テナントの ID
VITE_ENTRA_CLIENT_ID=       # Web 用のアプリの登録(SPA)の ID
VITE_API_SCOPE=             # API の利用範囲(例: api://<API のクライアント ID>/companion.access)
